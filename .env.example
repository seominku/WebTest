NODE_ENV=development
APP_ENV=local

# Browser/API origins
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-side Next.js API URL. Docker Compose overrides this with the api service name.
API_INTERNAL_BASE_URL=http://localhost:4000/api/v1
# Number of known reverse-proxy hops. Keep 0 for direct local access.
TRUST_PROXY_HOPS=0

# Address-to-coordinate lookup used when an agent creates or edits a listing.
# The public Nominatim service permits at most one request per second; use a
# dedicated provider or self-hosted instance for production traffic.
# Setting a provider URL alone does not transmit addresses. Change this flag to
# true only after the data-sharing checklist has been reviewed and approved.
GEOCODING_DATA_SHARING_APPROVED=false
# GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=real-estate-platform-local/0.1

# Alertmanager currently records alerts locally. Set this only when an external
# receiver has been reviewed and intentionally added to its configuration.
EXTERNAL_ALERT_DELIVERY_APPROVED=false

# Authentication hashing/HMAC secret (local example only; use a secret manager outside local Docker)
AUTH_HASH_SECRET=local-only-auth-hash-secret-change-this-before-any-shared-environment
METRICS_TOKEN=local-only-metrics-token-change-this-before-shared-use
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# PostgreSQL (local development only; replace outside local Docker)
POSTGRES_DB=real_estate
POSTGRES_USER=real_estate_app
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://real_estate_app:change-me-local-only@localhost:5432/real_estate?schema=public

# Redis
REDIS_PASSWORD=change-me-local-only-redis
REDIS_URL=redis://:change-me-local-only-redis@localhost:6379

# S3-compatible local object storage
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=change-me-local-only-too
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=real-estate-listings
S3_ACCESS_KEY=local-minio-admin
S3_SECRET_KEY=change-me-local-only-too
S3_FORCE_PATH_STYLE=true

# ClamAV malware scanner
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
