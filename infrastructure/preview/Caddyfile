{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "private, no-store"
		-Server
	}
	route {
		import /data/preview-access.caddy
		@blocked path /api/v1/health* /api/v1/metrics* /api/v1/admin* /api/v1/auth/register* /api/v1/auth/verify-email*
		respond @blocked 404
		request_body {
			max_size 12MB
		}
		@api path /api/*
		reverse_proxy @api preview-api:4000 {
			header_up -Authorization
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto https
			header_down Cache-Control "private, no-store"
		}
		reverse_proxy preview-web:3000 {
			header_up -Authorization
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto https
			header_down Cache-Control "private, no-store"
		}
	}
}
